{
  "name": "sas-lib",
  "version": "2.1.0",
  "repository": "git@github.com:solana-foundation/solana-attestation-service.git",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/src/index.mjs",
      "require": "./dist/src/index.js"
    },
    "./accounts": {
      "types": "./dist/types/generated/accounts/index.d.ts",
      "import": "./dist/src/accounts.mjs",
      "require": "./dist/src/accounts.js"
    },
    "./instructions": {
      "types": "./dist/types/generated/instructions/index.d.ts",
      "import": "./dist/src/instructions.mjs",
      "require": "./dist/src/instructions.js"
    }
  },
  "files": [
    "./dist/src",
    "./dist/types",
    "./src/"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && tsc -p ./tsconfig.declarations.json",
    "prepublishOnly": "npm run build",
    "test": "pnpm run build && mocha --require ts-node/register 'test/*.{ts,mjs}'",
    "test:surfpool": "mocha --require ts-node/register --timeout 120000 'test/surfpool/**/*.ts'"
  },
  "devDependencies": {
    "@solana/kit": "^8.3.0",
    "@solana/kit-plugin-rpc": "^0.18.0",
    "@solana/kit-plugin-signer": "^0.18.0",
    "@solana/surfpool": "^1.5.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "chai": "^4.5.0",
    "mocha": "^12.0.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@solana/kit": "^8.0.0"
  }
}
